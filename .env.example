# Copy to .env to override defaults. .env is git-ignored; never commit secrets.
# Every value below is optional: the application runs in synthetic/offline mode with none of them set.

# Where the SQLite database file lives (relative paths are relative to the project root).
SIH146_DB_PATH=data/sih146.db

# Existing synthetic raw dataset used by the CSV importer (read-only).
SIH146_DATASET_CSV=dataset/synthetic_bitcoin_transactions.csv

# Address the API listens on. Keep 127.0.0.1 so it is reachable only from this computer.
SIH146_HOST=127.0.0.1
SIH146_PORT=8000

# Browser origins allowed to call the API directly (the Vite dev server proxies /api, so this is optional).
SIH146_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Monitoring (synthetic / local only) -------------------------------------------------------
# Start the monitor with the server: it watches the inbox folder and re-analyses when data changes.
SIH146_MONITOR_AUTOSTART=true
# Seconds between monitor ticks (new data is analysed in micro-batches at this interval).
SIH146_MONITOR_INTERVAL=5
# Drop .csv / .jsonl files of new transactions here to have them ingested automatically.
SIH146_INBOX_DIR=data/stream_inbox
# Synthetic stream generator (off until enabled from the API/UI): seed and default rate.
SIH146_STREAM_SEED=146
SIH146_STREAM_RATE_PER_MINUTE=30

# ---- Synthetic network observations (IP / device / session) -------------------------------------
# These are SYNTHETIC demo data (documentation IP ranges only), never derived from the blockchain.
SIH146_NETWORK_CSV=data/synthetic_network_observations.csv
SIH146_NETWORK_SEED=148

# ---- Optional real Bitcoin source (OFF by default) ----------------------------------------------
# Reads recent confirmed blocks from an Esplora-compatible public API (read-only GET requests). Nothing contacts
# the network unless you enable this AND ask for a fetch (POST /api/sources/real-bitcoin/fetch or the CLI). The
# monitor never uses it. Real transactions are stored separately (source = real_bitcoin) and never receive
# synthetic IP/device data. The public Blockstream API needs no key; an optional key is sent as a Bearer token.
# NEVER commit a real key: keep it only in your local .env (git-ignored).
SIH146_REAL_BITCOIN_ENABLED=false
SIH146_REAL_BITCOIN_BASE_URL=https://blockstream.info/api
SIH146_REAL_BITCOIN_API_KEY=
SIH146_REAL_BITCOIN_TIMEOUT=15
SIH146_REAL_BITCOIN_REQUEST_DELAY=0.3
SIH146_REAL_BITCOIN_MAX_BLOCKS=5
SIH146_REAL_BITCOIN_MAX_TX_PER_BLOCK=500
